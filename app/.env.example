# Copy to .env.local and fill in to turn on the shared family space (cloud mode).
# Leave unset to run in local, single-device mode.
# Both values are public (they ship in the browser bundle); row-level security protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only after configuring the Apple provider in Supabase (needs an Apple Developer account).
VITE_ENABLE_APPLE_SIGNIN=false
